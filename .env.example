# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Redis
REDIS_URL=redis://localhost:6379
CART_IDEMPOTENCY_TTL_SECONDS=86400
DEVICE_INDEX_TTL_SECONDS=86400

# Postgres / pgvector
# Used for menu reads and the item_vector table. Cart state remains in Redis.
ODOO_DATABASE_URL=postgres://localhost:5432/odoo

# Odoo API
# Used to insert confirmed carts through the goopter_cart_api addon.
ODOO_API_URL=http://localhost:8069
ODOO_API_DATABASE=jadegarden1
# ODOO_API_KEY=

# Speech-to-text
STT_PROVIDER=assemblyai
STT_SAMPLE_RATE=16000
# End-of-turn endpointing: raise these to stop natural mid-order pauses splitting one
# order into several finals (one ordering turn + LLM call each). Higher = fewer splits
# but more reply latency (~STT_MIN_TURN_SILENCE_MS after the customer finishes).
STT_MIN_TURN_SILENCE_MS=1600
STT_MAX_TURN_SILENCE_MS=3600
# ASSEMBLYAI_API_KEY=

# Main LLM
# Supported providers: stub, ollama, openai
LLM_PROVIDER=stub
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# LLM_TIMEOUT_MS=30000

# Intent classifier
# Every INTENT_LLM_* var falls back to its LLM_* twin, so leaving all of them unset (the default)
# reuses the main provider: same endpoint + key + model is ONE quota, and the limiter registry gives
# both adapters ONE shared bucket.
#
# Change the endpoint, key or model and the classifier becomes a SECOND quota — which is fine, but
# it also inherits LLM_RPM/LLM_TPM by value, so each bucket is granted the FULL budget and you are
# shaping against 2× what you bought. Nothing warns: the two limiters are genuinely distinct, so
# there is no conflict to report. Whenever you uncomment anything below, set INTENT_LLM_RPM and
# INTENT_LLM_TPM explicitly to that model's own budget (see the rate-limiting section).
# INTENT_LLM_PROVIDER=openai
# INTENT_LLM_MODEL=gpt-4o-mini
# INTENT_LLM_BASE_URL=https://api.openai.com/v1
# INTENT_LLM_API_KEY=sk-...
# INTENT_LLM_TIMEOUT_MS=30000

# Text-to-speech
# Supported providers: cartesia, noop
TTS_PROVIDER=cartesia
TTS_MODEL=sonic-3.5
TTS_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238
TTS_LANGUAGE=en
TTS_ENCODING=mp3
TTS_SAMPLE_RATE=24000
TTS_BIT_RATE=128000
# CARTESIA_API_KEY=

# Menu filtering
# Comma-separated POS categories excluded during menu seeding.
# MENU_EXCLUDED_CATEGORIES=CUSTOMER TYPE

# Embeddings
# Supported providers: stub, jina
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024
# JINA_API_KEY=
# JINA_BASE_URL=https://api.jina.ai/v1/embeddings

# Rate limiting
# Proactive shaping of outbound calls to metered third parties.
# EVERY quota below is 0 = UNLIMITED by default, so rate limiting is OFF until you set it.
# With all quotas 0 the limiter is a no-op passthrough (no queues, no timers).
# The *_RATE_LIMIT_WAIT_MS values are wait budgets, not quotas: a caller waits that long for
# capacity and then fails fast so the turn degrades instead of hanging. They differ by call site
# because their latency budgets differ (TTS is mid-reply, STT happens once per session), and each
# is applied per call — two call sites sharing ONE quota may still set different wait budgets.
# Every value here must be plain decimal DIGITS: `0x10`, `1e3` and `5.0` are rejected with a
# `config.invalid_int` warning and the default is used instead.
#
# Read the numbers off your provider DASHBOARD, not off the internet:
#   - OpenAI no longer publishes a concrete RPM/TPM tier matrix; every figure circulating is
#     third-party. Your account's limits are on the platform usage/limits page.
#   - Jina's product page and docs portal publish CONTRADICTORY TPM figures (2M/50M vs 1M/5M),
#     and one key's quota is shared across all Jina products (embeddings, reranker, reader).
#
# Speech-to-text (AssemblyAI) — meters NEW SESSIONS PER MINUTE, not concurrent streams.
#   5/min on free, 100/min on paid; the ceiling auto-scales +10%/min above 70% utilization.
# STT_SESSIONS_PER_MIN=100
#   Cost guard, not a quota guard: AssemblyAI bills on socket-open time and auto-closes at 3h.
#   Setting ONLY this one caps spend but leaves NO rate dimension to back off on: when the
#   provider refuses a session there is nothing to hold back, and you get a
#   `ratelimit.penalty_unavailable` warning instead of `ratelimit.penalized`. Set
#   STT_SESSIONS_PER_MIN too if you want the refusal to slow us down.
# STT_MAX_CONCURRENT_SESSIONS=0
# STT_RATE_LIMIT_WAIT_MS=2000
#
# Text-to-speech (Cartesia) — meters CONCURRENT CONTEXTS: 2 Free / 3 Pro / 5 / 15 by plan.
#   There is deliberately no TTS_RPM: Cartesia publishes no request-rate limit.
#   NOTE: this backend uses the REST path, one call per reply segment, so a four-sentence reply
#   consumes four slots. Size accordingly.
# TTS_MAX_CONCURRENT=3
# TTS_RATE_LIMIT_WAIT_MS=800
#
# Main LLM — RPM and TPM per model pool.
# LLM_RPM=500
# LLM_TPM=200000
# LLM_MAX_CONCURRENT=0
# LLM_RATE_LIMIT_WAIT_MS=1500
#   Assumed reply size, ADDED to the prompt estimate for the per-call TPM reservation (a real
#   call is charged prompt + completion, so reserving only the larger of the two under-books
#   every call by the whole reply). It is NOT sent as max_tokens — nothing here truncates a
#   response — but the reservation basis never shrinks, so an oversized value burns your own
#   throughput on every call. Set it close to the expected response size; spoken replies are short.
# LLM_MAX_OUTPUT_TOKENS_EST=800
#
# Intent classifier — each falls back to its LLM_* twin when unset.
#   Leave them unset ONLY while the classifier shares the main provider's endpoint, key AND model
#   (the default): that is one quota, and the registry gives both adapters ONE shared bucket.
#   The moment INTENT_LLM_BASE_URL / INTENT_LLM_API_KEY / INTENT_LLM_MODEL differs from its twin,
#   the two adapters are SEPARATE limiters — and an unset INTENT_LLM_RPM/TPM copies the LLM_* value
#   into the second bucket, granting each the full budget. That is 2× what you configured, and it
#   is silent: a conflict is only reported when two call sites disagree about the SAME quota.
#   So: different model or endpoint ⇒ set both of these to that model's own numbers.
#   The inverse hazard is just as real and equally silent: zeroing ONE side of a SHARED pool
#   (LLM_RPM=0 with INTENT_LLM_RPM=500, or vice versa) does not average the two — first writer
#   wins, and if the first writer asked for nothing the whole pool ends up UNSHAPED. The boot line
#   `ratelimit.limits_conflict` reports `shaped:false` when that happens. Shared creds ⇒ set the
#   same numbers on both sides, or leave both unset.
# INTENT_LLM_RPM=
# INTENT_LLM_TPM=
# INTENT_LLM_MAX_CONCURRENT=
# INTENT_LLM_RATE_LIMIT_WAIT_MS=
#   Assumed reply size for the classifier, same role as LLM_MAX_OUTPUT_TOKENS_EST but deliberately
#   NOT inherited from it: the classifier's entire output is {"intent":"service"}. Default 32.
# INTENT_LLM_MAX_OUTPUT_TOKENS_EST=32
#
# Embeddings (Jina) — RPM and TPM, whichever trips first.
# EMBEDDING_RPM=500
# EMBEDDING_TPM=1000000
# EMBEDDING_MAX_CONCURRENT=0
# EMBEDDING_RATE_LIMIT_WAIT_MS=1000
